# AirLedger Environment Configuration Example
# AI provider selection: template (offline deterministic) or gemini (Google GenAI)
AI_PROVIDER=template

# Google Gemini API key (leave blank when using template provider)
GEMINI_API_KEY=

# Air data source mode: sample (offline calibrated data) or live (real-time OpenAQ/Open-Meteo)
AIR_DATA_MODE=sample

# API rate limiting maximum requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# Allowed CORS origins (comma-separated or wildcard in development)
CORS_ORIGINS=*

